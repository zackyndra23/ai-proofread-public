# =====================================================================
# AI Proofread - environment template
# Copy this file to .env and fill in the values. NEVER commit .env.
# =====================================================================

# --- API access ---
# UUID v4: 8-4-4-4-12 hex. Used by clients in the X-APIKey header.
API_KEY=00000000-0000-4000-8000-000000000000

# --- Flask ---
FLASK_ENV=production           # production | development
FLASK_DEBUG=0                  # 0 | 1
PORT=5000

# --- Anthropic Claude ---
# Pattern: ^sk-ant-[A-Za-z0-9_-]{20,}$
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048
MAX_INPUT_TOKEN=0              # 0 = unlimited
LLM_TEMPERATURE=0              # float (0..1)

# --- MongoDB ---
MONGO_URI=mongodb://<user>:<pass>@<host>:<port>/?authSource=admin&readPreference=primary&directConnection=true&ssl=false
MONGO_DB=proofread
STORE_DB=1                     # 1=write to MongoDB, 0=skip writes
DB_DISABLED=0                  # 1=disable Mongo completely (incl. rate-limit fallback)

# --- Pipeline auto-chain switches ---
AUTO_CHAIN_LLM=1
AUTO_CHAIN_UNMASK=1
AUTO_CHAIN_REFORMAT=1

# --- NER models (paths inside container; see docker-compose volume mounts) ---
NER_MODEL_DIR=/app/ner_model
LLM_PROMPT_DIR=/llm_prompt
LLM_PROMPT_DIR_PLAIN=/llm_prompt/plain

# Host-side overrides used by docker-compose
HOST_NER_MODEL_DIR=./ner_model
HOST_LLM_PROMPT_DIR=./llm_prompt
HOST_LLM_PROMPT_DIR_PLAIN=./llm_prompt/plain

# --- Rate limiting ---
RATE_LIMIT_RPS=20              # max requests per window
RATE_LIMIT_WINDOW_SEC=60       # window length in seconds

# --- API versioning ---
API_PREFIX=                    # leave empty -> mounts under /{API_VERSION}/...
API_VERSION=v1

# --- Build info (typically populated by CI) ---
APP_VERSION=0.1.0
BUILD=
GIT_SHA=
BUILD_AT=

# --- GPU ---
USE_GPU=1                      # 0 forces CPU
GPU_DEVICE_INDEX=0
CUDA_VISIBLE_DEVICES=0
NER_FP16=0                     # 1 = use float16 on GPU
NER_BATCH_SIZE=0               # >0 to enable batching
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=1

# --- Optional: Google Sheets QA push ---
RESULT_ANALYZE=INACTIVE        # ACTIVATE | INACTIVE
STORE_GSHEETS=0                # 1=push, 0=skip
GOOGLE_SHEET_ID=               # ~44-char Google Sheet ID
RESULT_ANALYZE_SHEET_TAB=      # tab name within the sheet
GOOGLE_SA_JSON_PATH=           # path inside container to the service-account JSON
HOST_SECRETS_DIR=              # host-side secrets dir for compose mount

# --- Language guard ---
LANGUAGE_MIN_CHARS=80          # below this -> detection treated as unreliable
LANGUAGE_CONFIDENCE_MIN=0.85   # auto-accept threshold (0..1)
LLM_LANG_VALIDATION=1          # 1 = enable Claude fallback on low confidence

# --- Security toggles (off by default) ---
SQL_INJECTION=off              # on|off - rejects SQLi-shaped payloads
HTML_FORMAT=off                # on|off - rejects raw HTML in data unless format=html|markdown
REJECT_SYMBOL_ONLY=on          # on|off - rejects symbol/digit-only payloads

# --- Semantic-text guard ---
TEXT_SEMANTIC_MIN_CHARS=40
TEXT_SEMANTIC_MIN_WORDS=10
LLM_SEMANTIC_VALIDATION=1

# --- Masking-model dataset mirror (optional, fail-safe) ---
# Mirrors a 9-field subset of masking_output to a separate collection for
# training-data curation. Strict toggle: only literal "ON" enables.
MASKING_RESULTS_FEATURE=OFF    # ON | OFF (default OFF, fail-safe)
MASKING_RESULTS_DC=masking_results
