# API Access
# UUID v4: 8-4-4-4-12 hex
API_KEY=00000000-0000-4000-8000-000000000000

# Flask
FLASK_ENV=                      # production | development
FLASK_DEBUG=                    # 0 | 1
PORT=2302

# Anthropic Claude API
# Pola: ^sk-ant-[A-Za-z0-9_-]{20,}$
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=                # model used e.g claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=           # integer
MAX_INPUT_TOKEN=                # integer | 0 = unlimited
LLM_TEMPERATURE=                # float (0..1)

# MongoDB
MONGO_URI=mongodb://<user>:<pass>@<host>:<port>/?authSource=admin&readPreference=primary&directConnection=true&ssl=false
MONGO_DB=                       # database name e.g AI_Proofread
STORE_DB=1                      # 1=store to MongoDB, 0=skip writes
DB_DISABLED=0                   # 1=disable Mongo completely (incl. rate limit)

# Auto-chain ON (tanpa query params)
AUTO_CHAIN_LLM=                 # 0 | 1
AUTO_CHAIN_UNMASK=              # 0 | 1
AUTO_CHAIN_REFORMAT=            # 0 | 1

# Di dalam container (standar)
NER_MODEL_DIR=              # NER model path
LLM_PROMPT_DIR=             # LLM collection prompts path (plain and html format)
LLM_PROMPT_DIR_PLAIN=       # LLM collection prompts path (plain)

# (opsional) override host path saat compose
HOST_NER_MODEL_DIR=         # Host NER model path
HOST_LLM_PROMPT_DIR=        # Host LLM collection prompts path (plain and html format)
HOST_LLM_PROMPT_DIR_PLAIN=  # Host LLM collection prompts path (plain)

# Rate limiting
RATE_LIMIT_RPS=                 # integer (limit API trigger in every certain moment)
RATE_LIMIT_WINDOW_SEC=          # integer (moment definition within second)

BASE_PREFIX=/aitegrity-core/aiproofread

# Application versioning
API_VERSION=v1
API_PREFIX=

# Build info (opsional diisi oleh CI)
BUILD=
GIT_SHA=
BUILD_AT=

# GPU
USE_GPU=1                       # 0 | 1
GPU_DEVICE_INDEX=0              # GPU index (0,1,2...)
CUDA_VISIBLE_DEVICES=0          # Optional: limit visible GPUs
NER_FP16=0                      # 1=use float16 on GPU
NER_BATCH_SIZE=0                # >0 to enable batching
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=1

# ===== Result Analyze Switch =====
RESULT_ANALYZE=ACTIVATE         # ACTIVATE | INACTIVE
STORE_GSHEETS=1                 # 1=store to Google Sheets, 0=skip

# ===== Google Sheets Target =====
# Pola: Google Sheet ID (base62-ish, length ~44)
GOOGLE_SHEET_ID=                # base62-ish, length ~44
RESULT_ANALYZE_SHEET_TAB=       # sheet name on google sheet target e.g V01_Plain_Analysis_Part02

# ===== Google Service Account =====
GOOGLE_SA_JSON_PATH=            # Google credential path stored in the container

# (opsional) lokasi folder secrets di host
HOST_SECRETS_DIR=               # Host google credential path stored in the container

LANGUAGE_MIN_CHARS=             # Minimum text length for reliable
LANGUAGE_CONFIDENCE_MIN=        # Acceptance threshold (0..1) for auto-accept language
LLM_LANG_VALIDATION=            # Enable Claude fallback on low-confidence detection (`1` on, `0` off)

# ===== Data Masking Model Improvement =====
# Mirror subset (9 whitelist fields) of masking_output to a separate collection
# for future masking-model training datasets. Fail-safe: default OFF.
MASKING_RESULTS_FEATURE=ON                              # ON | OFF (strict; only "ON" case-insensitive enables)
MASKING_RESULTS_DC=AIProofread_Masking_Results           # destination collection name